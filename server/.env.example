# MySQL Database
DB_HOST=192.168.75.101
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=erlbrew

# Server
PORT=3000
NODE_ENV=production

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=*

# Basic auth for admin panel
ADMIN_USERNAME=admin
# Generate your hash: node bin/hash-password.js
ADMIN_PASSWORD_HASH=$2b$12$your_bcrypt_hash_here

# Admin panel secret path (hidden from public)
ADMIN_SECRET_PATH=/your-secret-path
# Optional: Add a token for extra security (leave empty to disable)
ADMIN_ACCESS_TOKEN=

# Email notifications (optional - for event inquiry alerts)
# SMTP configuration for sending email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Email address to receive inquiry notifications
NOTIFICATION_EMAIL=admin@erlbrewcafe.com
