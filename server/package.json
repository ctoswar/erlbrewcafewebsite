{
  "name": "erlbrew-backend",
  "version": "1.0.0",
  "description": "Erlbrew Café backend — gallery photo storage with MySQL",
  "main": "server.js",
  "scripts": {
    "start": "npm run build:css && node server.js",
    "dev": "node --watch server.js",
    "dev:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --watch",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --minify",
    "setup": "node bin/setup-db.js",
    "hash:password": "node bin/hash-password.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "multer": "^2.2.0",
    "mysql2": "^3.24.3"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
