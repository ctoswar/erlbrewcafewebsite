# MySQL Database - Set these in Cloudflare Environment Variables
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Server
PORT=3000
NODE_ENV=production

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://your-domain.com

# Basic auth for admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your-bcrypt-hash-here

# Admin panel secret path (hidden from public)
ADMIN_SECRET_PATH=/your-secret-path
# Optional: Add a token for extra security (leave empty to disable)
ADMIN_ACCESS_TOKEN=
